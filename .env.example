# Settings of the Cloud Registry UI (see "Configurations" in the README).
#
# All settings are read when the app starts (`bun run dev`, `bun run start`,
# `docker run`): change them, then restart the app; no new build is needed.
# For local development, copy this file to `.env`. For Docker, pass the
# settings at start, from a file outside the repository:
#   docker run -p 3000:3000 --env-file ~/cloud-registry-ui/settings.env cloud-registry-ui
# `--env-file` takes each line literally as NAME=value: don't quote values.
# The image is built without settings (no `--build-arg`).
#
# `NEXT_PUBLIC_*` settings reach the browser: never put secrets in them.

# --- Registry -------------------------------------------------------------

# Required: the registry's API, including the base path; `https`, or `http`
# for localhost
NEXT_PUBLIC_CLOUD_REGISTRY_URL=http://localhost:8080/ga4gh/registry/v1

# Schemes the registry allows for service URLs: https (default), http or
# http,https
# NEXT_PUBLIC_SERVICE_URL_SCHEMES=https

# Environments the registry allows, comma-separated, or * for any
# NEXT_PUBLIC_SERVICE_ENVIRONMENTS=prod,test,dev,staging

# --- Branding (optional) --------------------------------------------------

# NEXT_PUBLIC_APP_TITLE=Cloud Registry
# NEXT_PUBLIC_APP_TITLE_SIZE=24
# NEXT_PUBLIC_APP_TITLE_FONT=Open Sans
# Logos: a path to a default file in public/, or a URL
# NEXT_PUBLIC_APP_LOGO=/elixir-on-cloud-mark.svg
# NEXT_PUBLIC_APP_LOGO_DARK=/elixir-on-cloud-mark-night.svg
# NEXT_PUBLIC_FOOTER_LOGO=/elixir-on-cloud-lockup.svg
# NEXT_PUBLIC_FOOTER_LOGO_DARK=/elixir-on-cloud-lockup-night.svg
# NEXT_PUBLIC_FOOTER_START_YEAR=2024

# --- Login (server only; holds the client secret) -------------------------

# Required: login providers as a JSON list, on one line
LOGIN_PROVIDERS=[{"id": "ls-login", "name": "LS Login", "logo": "/ls-login-grey-wide.jpg", "issuer": "https://login.aai.lifescience-ri.eu/oidc/", "clientId": "<client ID>", "clientSecret": "<client secret>", "scopes": ["openid", "profile", "email", "eduperson_entitlement"]}]

# Required: the app's callback URL, registered with the login provider
LOGIN_REDIRECT_URI=http://localhost:3000/auth/api/callback
