# Copy to .env and adjust (see the README). NEXT_PUBLIC_* variables are read
# when the app is built (bun run build), the login settings when it starts
# (bun run start). docker build ignores .env: for images, pass the
# NEXT_PUBLIC_* variables with docker build --build-arg and the login
# settings with docker run --env-file instead.

# Login (read at start)
LOGIN_PROVIDERS=[{"id": "ls-login", "name": "LS Login", "logo": "/ls-login-grey-wide.jpg", "issuer": "https://login.aai.lifescience-ri.eu/oidc/", "clientId": "<client ID>", "clientSecret": "<client secret>", "scopes": ["openid", "profile", "email", "eduperson_entitlement"]}]
LOGIN_REDIRECT_URI=http://localhost:3000/auth/api/callback

# Registry (read at build)
NEXT_PUBLIC_CLOUD_REGISTRY_URL=https://registry.example.org/ga4gh/registry/v1
# NEXT_PUBLIC_SERVICE_URL_SCHEMES=http,https
# Environments the registry allows, comma-separated, or * for any
# NEXT_PUBLIC_SERVICE_ENVIRONMENTS=prod,test,dev,staging

# Branding (read at build; defaults: ELIXIR On-Cloud logos, "Cloud Registry", current year only)
# Title: at most two lines of at most 24 characters, broken at spaces
# NEXT_PUBLIC_APP_TITLE=Cloud Registry
# Largest title size in px; can only lower the default (24 for one line, what fits for two)
# NEXT_PUBLIC_APP_TITLE_SIZE=24
# NEXT_PUBLIC_APP_TITLE_FONT=Georgia, serif
# _DARK = the logo shown in the dark colour scheme, i.e. a light-coloured logo for a dark background;
# a custom logo without _DARK is used in both colour schemes, on a white backing in the dark one
# NEXT_PUBLIC_APP_LOGO=/elixir-on-cloud-mark.svg
# NEXT_PUBLIC_APP_LOGO_DARK=/elixir-on-cloud-mark-night.svg
# NEXT_PUBLIC_FOOTER_LOGO=/elixir-on-cloud-lockup.svg
# NEXT_PUBLIC_FOOTER_LOGO_DARK=/elixir-on-cloud-lockup-night.svg
# NEXT_PUBLIC_FOOTER_START_YEAR=2024
