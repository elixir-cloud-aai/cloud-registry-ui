# Copy to .env and adjust. NEXT_PUBLIC_* variables are set when the app is built.

# Login (LS Login or another OpenID Connect provider)
LS_LOGIN_URL=https://login.aai.lifescience-ri.eu
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/api/callback

# Cloud Registry API
NEXT_PUBLIC_CLOUD_REGISTRY_URL=https://cloud-registry.example.org/ga4gh/registry/v1
# NEXT_PUBLIC_SERVICE_URL_SCHEMES=http,https

# Branding (defaults: ELIXIR On-Cloud logo, "Cloud Registry")
# NEXT_PUBLIC_APP_TITLE=Cloud Registry
# NEXT_PUBLIC_APP_LOGO=/elixir-on-cloud-mark.svg
