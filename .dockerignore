# Allow list: the build gets only what it needs, so that local settings and
# secrets (env files, keys, credentials) can't reach the build stage, its
# cache or the image (see README)
*
!src/
!public/
!package.json
!bun.lock
!next.config.ts
!tsconfig.json
!postcss.config.mjs
!components.json

# also not inside the allowed folders
**/.env*
**/.vercel
**/certificates
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.npmrc
**/bunfig.toml
**/.DS_Store
**/*.log
