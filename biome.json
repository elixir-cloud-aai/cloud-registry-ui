{
    "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "noRestrictedImports": {
                    "level": "error",
                    "options": {
                        "paths": {
                            "zod": "Import z from \"@/lib/zod\", which sets zod up for the Content Security Policy."
                        },
                        "patterns": [
                            {
                                "group": ["zod/**"],
                                "message": "Import z from \"@/lib/zod\", which sets zod up for the Content Security Policy."
                            }
                        ]
                    }
                }
            }
        },
        "domains": {
            "next": "recommended",
            "react": "recommended"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["src/lib/zod.ts", "src/lib/login-providers.ts"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": "off"
                    }
                }
            }
        }
    ]
}
